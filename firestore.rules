rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the current user is an authorized Store Administrator
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        request.auth.email == 'daniyaljunejo2002@gmail.com' ||
        request.auth.email == 'admin@junejosuperstore.pk' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email != null && request.auth.token.email.matches('.*admin.*'))
      );
    }

    // Public Store Catalog: Products
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Public Categories
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Monthly Rashan Packages
    match /rashanPackages/{packageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Deals & Promo Banners
    match /deals/{dealId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /promoBanners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Store Settings & Hyderabad Delivery Configuration
    match /storeSettings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Homepage Hero and Promo Configuration
    match /homepage/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Customer Orders:
    // Any customer in Hyderabad can place a new order (create).
    // Admin has full view and status update permissions.
    match /orders/{orderId} {
      allow create: if true;
      allow read: if true;
      allow update, delete: if isAdmin();
    }

    // Customer Records & History
    match /customers/{customerId} {
      allow read: if isAdmin();
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // Admins registry collection
    match /admins/{adminUid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
